# --- Sketch → Excel tool (/sketch-to-excel) ---------------------------------
# Server-side only. Never prefix these with NEXT_PUBLIC_.

# Claude API key used to read the drawings (required for automatic analysis).
ANTHROPIC_API_KEY=

# Optional overrides
# SKETCH_AI_MODEL=claude-opus-5-5
# SKETCH_AI_EFFORT=high          # interpretation pass: low | medium | high | xhigh | max
# SKETCH_OCR_EFFORT=medium       # transcription pass

# Protects template upload / mapping changes (/sketch-to-excel/admin).
# Without it, admin changes are only possible in local development.
SKETCH_ADMIN_TOKEN=

# Optional: require this code before anyone can run analyses or exports.
# Recommended on a public website so the paid AI endpoint isn't open to all.
SKETCH_ACCESS_CODE=

# Where uploaded templates are stored (default ./storage/templates).
# Must be a persistent, writable folder on the server.
# TEMPLATE_STORAGE_DIR=/var/lib/avina/templates

# Demo mode: fixed example output, NOT read from the image (UI testing only).
# SKETCH_AI_PROVIDER=demo
